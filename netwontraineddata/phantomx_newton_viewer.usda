over "World"
{
    def Scope "Looks"
    {
        def Material "PhantomXGray"
        {
            token outputs:surface.connect = </World/Looks/PhantomXGray/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.62
                token outputs:surface
            }
        }

        def Material "FootRubber"
        {
            token outputs:surface.connect = </World/Looks/FootRubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.17, 0.18)
                float inputs:metallic = 0
                float inputs:roughness = 0.82
                token outputs:surface
            }
        }
    }

